# Copia a .env y ajusta. Nunca subas .env al repositorio.
PORT=3000
HOST=127.0.0.1
# Docker + perfil https (Caddy): dominio público con DNS apuntando a esta máquina
# DOMAIN=destree.ejemplo.com
# DATABASE_PATH=./data/destree.db
# LOG_LEVEL=info
# Carpeta de imágenes (por defecto junto a la BD: data/uploads)
# UPLOADS_DIR=./data/uploads
# Versiones automáticas conservadas por página y ventana (min) de coalescencia
# VERSIONS_KEEP=50
# VERSIONS_COALESCE_MIN=5
# Respaldos programados (cron de 5 campos, hora local), retención y carpeta
# BACKUP_CRON=30 3 * * *
# BACKUP_KEEP=10
# BACKUPS_DIR=./data/backups
# Detrás de un proxy TLS (cookie Secure + X-Forwarded-*)
# TRUST_PROXY=1
