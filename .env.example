# Copia a .env y ajusta. Nunca subas .env al repositorio.
PORT=3000
HOST=127.0.0.1
# Docker + perfil https (Caddy): dominio público con DNS apuntando a esta máquina
# DOMAIN=destree.ejemplo.com
# DATABASE_PATH=./data/destree.db
# LOG_LEVEL=info
# Carpeta de imágenes (por defecto junto a la BD: data/uploads)
# UPLOADS_DIR=./data/uploads
# Versiones automáticas conservadas por página y ventana (min) de coalescencia
# VERSIONS_KEEP=50
# VERSIONS_COALESCE_MIN=5
# Respaldos programados (cron de 5 campos, hora local), retención y carpeta
# BACKUP_CRON=30 3 * * *
# BACKUP_KEEP=10
# BACKUPS_DIR=./data/backups
# Detrás de un proxy TLS (cookie Secure + X-Forwarded-*)
# TRUST_PROXY=1
# Correo (invitaciones y recuperación de contraseña). Sin SMTP_URL la app funciona copiando enlaces a mano.
# smtp://usuario:contraseña@smtp.ejemplo.com:587 (STARTTLS) · smtps://…:465 (TLS) · ?starttls=0 · ?insecure=1 (sin verificar certificado)
# SMTP_URL=smtp://usuario:contrase%C3%B1a@smtp.ejemplo.com:587
# MAIL_FROM=DesTree <no-reply@ejemplo.com>
# Base de los enlaces en los correos (si falta se deduce de la petición)
# PUBLIC_URL=https://destree.ejemplo.com
# Desarrollo: `docker compose --profile dev up -d` arranca Mailpit (http://localhost:8025) → SMTP_URL=smtp://mailpit:1025
