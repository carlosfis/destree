# Copia a .env y ajusta. Nunca subas .env al repositorio.
PORT=3000
HOST=127.0.0.1
# DATABASE_PATH=./data/destree.db
# LOG_LEVEL=info
# Desde F5: carpeta de imágenes (por defecto junto a la BD: data/uploads)
# UPLOADS_DIR=./data/uploads
# Desde F6a: versiones auto conservadas por página y ventana (min) de coalescencia
# VERSIONS_KEEP=50
# VERSIONS_COALESCE_MIN=5
# Desde F2: detrás de un proxy TLS (cookie Secure + X-Forwarded-*)
# TRUST_PROXY=1
# Desde F8a: cifrado del PAT de Figma
# SERVER_SECRET=cambia-esto-por-32-bytes-aleatorios
# Desde F8a (opcional; sin PAT la app funciona completa):
# FIGMA_PAT=
