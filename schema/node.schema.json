{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "node.schema.json",
  "title": "Node",
  "description": "Card del árbol. x,y son locales respecto al contenedor padre (mundo si es raíz). w,h: tamaño mínimo manual del contenedor (0 = automático).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "parentId", "x", "y"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "type": { "type": "string", "enum": ["software", "ds", "uikit"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 140, "default": "" },
    "image": { "type": ["string", "null"], "pattern": "^data:image/", "maxLength": 2000000, "default": null, "description": "dataURL legado; F5 lo sustituye por imageId (P12: la card ya no muestra imagen; se conserva por compatibilidad)" },
    "imageId": { "type": ["string", "null"], "default": null },
    "geo": { "type": "string", "pattern": "^([A-Z]{2})?$", "default": "", "description": "Geografía del thumbnail: ISO 3166-1 alfa-2 en mayúsculas; '' = ninguna" },
    "thumbIconId": { "type": ["string", "null"], "default": null, "description": "Icono del thumbnail (images.id); null = sin icono" },
    "gradient": { "type": "string", "enum": ["", "sunset", "violet", "candy", "ocean", "mint", "aurora", "berry", "cobalt", "amber", "flamingo"], "default": "", "description": "P12: degradado de marca; obligatorio en Main instances (defecto mint), '' en cards anidadas. Sustituye a la imagen hero (imageId se conserva por compatibilidad)" },
    "tags": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "default": [] },
    "owner": { "type": "string", "maxLength": 80, "default": "", "description": "Responsable legado en texto (\"@ana\"); se mantiene igual a staff[0].name" },
    "staff": { "type": "array", "maxItems": 20, "default": [], "description": "Equipo: usuario (texto @nombre) y rol", "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "role": { "type": "string", "maxLength": 80, "default": "" } } } },
    "ownerUserId": { "type": ["string", "null"], "default": null },
    "parentId": { "type": ["string", "null"], "maxLength": 64, "description": "software contenedor; null = raíz. Obligatorio para ds y uikit" },
    "branchTypeId": { "type": ["string", "null"], "maxLength": 64, "default": null, "description": "solo software anidado" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "w": { "type": "number", "minimum": 0, "default": 0 },
    "h": { "type": "number", "minimum": 0, "default": 0 },
    "demo": { "type": "boolean", "default": false },
    "notes": { "type": "string", "maxLength": 4000, "default": "", "description": "markdown" },
    "docs": { "type": "array", "maxItems": 20, "default": [], "items": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string", "maxLength": 80 }, "url": { "type": "string", "format": "uri", "maxLength": 2048 } } } },
    "visibility": { "type": "string", "enum": ["org", "cells", "inherit"], "default": "inherit", "description": "raíz: org|cells; hijos: inherit" },
    "status": { "type": "string", "enum": ["active", "draft", "deprecated", "archived"], "default": "active" },
    "cellIds": { "type": "array", "maxItems": 50, "default": [], "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "description": "solo raíces con visibility=cells" },
    "assigneeIds": { "type": "array", "maxItems": 50, "default": [], "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "hasExternalRefs": { "type": "boolean", "default": false, "description": "solo en GET filtrado (designer): aristas omitidas por visibilidad" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
