{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "page-document.schema.json",
  "title": "PageDocument",
  "description": "Documento completo de una página (v3): lo que viaja en GET/PUT /api/pages/:id, import/export y snapshots. settings y camera conservan el shape del estado del cliente (theme y tool no se persisten en servidor).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "page", "nodes", "edges", "tags", "branchTypes"],
  "properties": {
    "version": { "const": 3 },
    "page": { "$ref": "page.schema.json#" },
    "nodes": { "type": "array", "maxItems": 2000, "items": { "$ref": "node.schema.json#" } },
    "edges": { "type": "array", "maxItems": 5000, "items": { "$ref": "edge.schema.json#" } },
    "tags": { "type": "array", "maxItems": 200, "items": { "$ref": "tag.schema.json#" } },
    "branchTypes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "branch-type.schema.json#" } },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snap": { "type": "boolean", "default": true },
        "grid": { "type": "boolean", "default": true },
        "minimap": { "type": "boolean", "default": true },
        "theme": { "type": ["string", "null"], "enum": ["light", "dark", null], "default": null },
        "tool": { "type": "string", "enum": ["select", "hand"], "default": "select" },
        "typeNames": { "type": "object", "additionalProperties": false, "description": "Nombres visibles de los tipos (por página); la semántica y las reglas de anidación no cambian", "properties": { "software": { "type": "string", "minLength": 1, "maxLength": 40 }, "ds": { "type": "string", "minLength": 1, "maxLength": 40 }, "uikit": { "type": "string", "minLength": 1, "maxLength": 40 } } }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number", "minimum": 0.1, "maximum": 4 } }
    }
  }
}
